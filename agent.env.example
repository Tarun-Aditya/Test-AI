# Settings for agent.sh / agent.bat. Copy to agent.env (which git ignores: it holds the token) and fill in.
# Lines starting with # are ignored. No quotes, no spaces around =.

# The hub's address as this computer reaches it
AIAUTO_SERVER=http://hub.example.com:8000
# A token from the hub: Machines -> Agent tokens -> New token
AIAUTO_AGENT_TOKEN=paste-the-token-here
# How this computer appears in the machine list (default: its host name)
AGENT_NAME=
# How many tests it runs at the same time (about 1 GB of memory each)
AIAUTO_SLOTS=2
# Optional: this computer's own AI (otherwise the hub answers its AI calls)
# ANTHROPIC_API_KEY=
