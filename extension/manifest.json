{
  "manifest_version": 3,
  "name": "Autopilot: run a scenario on this page",
  "short_name": "Autopilot",
  "version": "0.1.0",
  "description": "Paste a test scenario in plain English or business language and run it right on the page you have open. Follows new tabs.",
  "minimum_chrome_version": "126",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Autopilot: run a scenario on this page",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "scripting",
    "tabs",
    "storage",
    "sidePanel",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Autopilot"
    }
  }
}
